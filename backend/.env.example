DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# === 用户登录 / VIP 支付配置 ===
# 生产环境必须换成足够长的随机字符串；本地开发也不要留空。
AUTH_SECRET_KEY=change-me-to-a-long-random-string

# 本地 http 开发用 false；生产 HTTPS 必须改 true。
AUTH_COOKIE_SECURE=false

# 前端地址，用于 Stripe Checkout 支付成功/取消后的跳转。
PUBLIC_APP_URL=http://127.0.0.1:5173

# SQLite 数据库路径。默认也会落在 backend/downloads/app.sqlite3。
FVD_DB_PATH=./downloads/app.sqlite3

# Stripe 测试/生产密钥。优先使用 rk_ 开头的 Restricted Key；测试也可先用 sk_test_。
STRIPE_API_KEY=rk_test_or_sk_test_xxx

# Stripe CLI listen 或 Dashboard webhook endpoint 生成的签名密钥。
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Dashboard 里“一次性价格”的 price_...；币种和金额由这个 Price 决定。
# 也可以直接填 CNY 9.90，让后端按人民币 9.90 动态创建 price_data。
STRIPE_VIP_PRICE_ID=price_xxx

# 完全无外网时设为 true，只验证本地注册、支付入口、VIP 解锁闭环。
STRIPE_MOCK_MODE=false

# === 邮箱验证码配置（SMTP） ===
# 用于注册和登录的邮箱验证码。
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USER=your-email@qq.com
SMTP_PASSWORD=your-smtp-auth-code
SMTP_FROM_NAME=影知

# === YouTube 反 Bot 检测配置 ===
#
# PO Token Provider 已内置于 backend/pot_server/，默认无需配置。
# 首次启动前运行: cd backend/pot_server && npm install
# 启动后端时自动运行 Node.js PO Token 服务器。

# 如需自定义路径（通常不需要）：
# POT_SERVER_PATH=D:/1Code/bgutil-ytdlp-pot-provider/server

# PO Token Provider HTTP 地址（默认 http://127.0.0.1:4416）
# POT_PROVIDER_URL=http://127.0.0.1:4416

# Cookie 来源: firefox / chrome / edge / brave 等浏览器名称
# Firefox 通常无需解密密码，推荐使用
YTDLP_COOKIE_BROWSER=firefox

# Cookie 文件备选（当未设置 YTDLP_COOKIE_BROWSER 时生效）
# YTDLP_COOKIE_FILE=/path/to/cookies.txt

# JS 运行时（用于 NSig 挑战求解），默认 node
# YTDLP_JS_RUNTIME=node

# 远程组件（JS 挑战求解器脚本），默认从 GitHub 下载
# YTDLP_REMOTE_COMPONENTS=ejs:github
